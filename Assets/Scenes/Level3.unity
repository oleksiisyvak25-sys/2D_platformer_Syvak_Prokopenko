      objectReference: {fileID: 0}
    - target: {fileID: 5611633731753175774, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: avatar
      value: 
      objectReference: {fileID: 761469410373661872, guid: 8c2b806bf10f4ad5baa77c7b85c41d5d, type: 3}
    - target: {fileID: 5611633731753175774, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: speakerName
      value: Sofiia
      objectReference: {fileID: 0}
    - target: {fileID: 5611633731753175774, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: lines.Array.size
      value: 15
      objectReference: {fileID: 0}
    - target: {fileID: 5611633731753175774, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: lines.Array.data[0].text
      value: Hi, Pablo
      objectReference: {fileID: 0}
    - target: {fileID: 5611633731753175774, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: lines.Array.data[1].text
      value: Check out my Slime farm
      objectReference: {fileID: 0}
    - target: {fileID: 5611633731753175774, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: lines.Array.data[2].text
      value: They don't give milk, eggs, or wool
      objectReference: {fileID: 0}
    - target: {fileID: 5611633731753175774, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: lines.Array.data[3].text
      value: They're just cool
      objectReference: {fileID: 0}
    - target: {fileID: 5611633731753175774, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: lines.Array.data[4].text
      value: Well, you know...
      objectReference: {fileID: 0}
    - target: {fileID: 5611633731753175774, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: lines.Array.data[5].text
      value: SOOOOO COOL!!!
      objectReference: {fileID: 0}
    - target: {fileID: 5611633731753175774, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: lines.Array.data[6].text
      value: I have 5 of them
      objectReference: {fileID: 0}
    - target: {fileID: 5611633731753175774, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: lines.Array.data[7].text
      value: "Here\u2019s Tuzik, Mila, Alpatov, Sharik, and..."
      objectReference: {fileID: 0}
    - target: {fileID: 5611633731753175774, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: lines.Array.data[8].text
      value: ...
      objectReference: {fileID: 0}
    - target: {fileID: 5611633731753175774, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: lines.Array.data[9].text
      value: "Where\u2019s Rostik!?"
      objectReference: {fileID: 0}
    - target: {fileID: 5611633731753175774, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: lines.Array.data[10].text
      value: OH NOOO
      objectReference: {fileID: 0}
    - target: {fileID: 5611633731753175774, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: lines.Array.data[11].text
      value: "Rostik ran away\u2014that\u2019s bad"
      objectReference: {fileID: 0}
    - target: {fileID: 5611633731753175774, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: lines.Array.data[12].text
      value: "I don\u2019t know if you\u2019ve heard, but some guys from other games
        have shown up at the castle"
      objectReference: {fileID: 0}
    - target: {fileID: 5611633731753175774, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: lines.Array.data[13].text
      value: "No one\u2019s waiting for them in their own games anymore, so they
        decided to take over our world"
      objectReference: {fileID: 0}
    - target: {fileID: 5611633731753175774, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: lines.Array.data[14].text
      value: Find Rostik, but be careful
      objectReference: {fileID: 0}
    - target: {fileID: 7075079077301872791, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
      propertyPath: m_Sprite
      value: 
      objectReference: {fileID: -6511610701255145038, guid: 7a9e25b8012ea026698c54bd59906d21, type: 3}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 2f0b37f8e2294c059849443d2abea237, type: 3}
