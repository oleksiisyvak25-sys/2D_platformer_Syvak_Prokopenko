  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 525d610193ba52d66b80caa57e3ff025, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNPC
  speakerName: Yevheniia
  avatar: {fileID: 2596813409449600934, guid: eab2600750b3f9218884dc08fdca217f, type: 3}
  lines:
  - text: Hello Pablo
    speakerOverride: 
    avatarOverride: {fileID: 0}
    autoAdvanceDelay: 0
  - text: "Haven't seen you around here in a while\u2014let me remind you about the
      movement"
    speakerOverride: 
    avatarOverride: {fileID: 0}
    autoAdvanceDelay: 0
  - text: Press A/D to move
    speakerOverride: 
    avatarOverride: {fileID: 0}
    autoAdvanceDelay: 0
  - text: Press SPACE to jump. Use double jumps to reach harder-to-reach spots
    speakerOverride: 
    avatarOverride: {fileID: 0}
    autoAdvanceDelay: 0
  - text: Don't forget to activate the flags so you don't have to start the whole
      level over from the beginning
    speakerOverride: 
    avatarOverride: {fileID: 0}
    autoAdvanceDelay: 0
  - text: "And be careful of the spikes\u2014they'll kill you INSTANTLY"
    speakerOverride: 
    avatarOverride: {fileID: 0}
    autoAdvanceDelay: 0
  repeatLines: []
  legacyData: {fileID: 0}
  interactKey: 101
  interactPrompt: {fileID: 1712379392}
  oneTimeOnly: 0
  onDialogueStarted:
    m_PersistentCalls:
      m_Calls: []
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
